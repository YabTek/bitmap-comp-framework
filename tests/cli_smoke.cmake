# End-to-end tests write exclusively inside the build tree.
file(MAKE_DIRECTORY "${OUTPUT}")
function(run_ok)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Command failed (${code}): ${ARGV}\n${out}\n${err}")
  endif()
endfunction()
function(run_bad)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(code EQUAL 0)
    message(FATAL_ERROR "Invalid command unexpectedly succeeded: ${ARGV}")
  endif()
endfunction()
run_ok("${BENCH}" --help)
run_ok("${BENCH}" --version)
run_ok("${BENCH}" --list-backends)
run_ok("${GENERATOR}" --help)
run_ok("${INSPECTOR}" --help)
run_ok("${GENERATOR}" "--out=${OUTPUT}/queries.txt" --num-bitmaps=6 --num-queries=12 --min-width=2 --max-width=4 --seed=43)
foreach(backend raw wah ewah roaring concise plwah val sbh bbc)
  run_ok("${BENCH}" "--backend=${backend}" "--dataset=${DATA}" "--queries=${OUTPUT}/queries.txt"
    "--out=${OUTPUT}/${backend}.csv" --repetitions=2 --warmup=1 --build-repetitions=2 --verify=1 "--save=${OUTPUT}/${backend}.bmc")
  file(SIZE "${OUTPUT}/${backend}.bmc" saved_size)
  if(saved_size LESS 32)
    message(FATAL_ERROR "Incomplete archive: ${backend}")
  endif()
  run_ok("${BENCH}" "--backend=${backend}" "--dataset=${DATA}" "--queries=${OUTPUT}/queries.txt"
    "--out=${OUTPUT}/${backend}-loaded.csv" --repetitions=1 --verify=1 "--load=${OUTPUT}/${backend}.bmc")
  run_ok("${INSPECTOR}" "--backend=${backend}" "--dataset=${DATA}" --bitmap=0 --max-bytes=16 --max-positions=4)
endforeach()
run_ok("${BENCH}" --backend=val "--dataset=${DATA}" "--queries=${OUTPUT}/queries.txt"
  "--out=${OUTPUT}/val-auto.csv" --repetitions=1 --verify=1 --val-segment-bits=auto)
run_bad("${BENCH}" --backend=missing "--dataset=${DATA}" "--queries=${OUTPUT}/queries.txt" "--out=${OUTPUT}/bad.csv")
run_bad("${BENCH}" --backend=raw "--dataset=${DATA}" "--queries=${OUTPUT}/queries.txt" "--out=${OUTPUT}/bad.csv" --repetitions=-1)
run_bad("${BENCH}" --backend=raw "--dataset=${DATA}" "--queries=${OUTPUT}/queries.txt" "--out=${OUTPUT}/bad.csv" --verify=maybe)
run_bad("${GENERATOR}" "--out=${OUTPUT}/bad.txt" --num-bitmaps=2 --num-queries=1 --min-width=0)
run_bad("${GENERATOR}" "--out=${OUTPUT}/bad.txt" --num-bitmaps=2 --num-queries=1 --seed=-1)
file(WRITE "${OUTPUT}/bad-queries.txt" "AND 2 0 999\n")
run_bad("${BENCH}" --backend=raw "--dataset=${DATA}" "--queries=${OUTPUT}/bad-queries.txt" "--out=${OUTPUT}/bad.csv")
message(STATUS "All nine backends passed CLI build/save/load/AND/OR verification")
# A valid zero-length dataset still has one bitmap and nonempty query file.
file(MAKE_DIRECTORY "${OUTPUT}/zero")
file(WRITE "${OUTPUT}/zero/metadata.txt" "num_bits=0\nnum_bitmaps=1\nword_bits=64\nformat=raw_uint64_le\n")
file(WRITE "${OUTPUT}/zero/bitmap_000.bin" "")
file(WRITE "${OUTPUT}/zero/queries.txt" "AND 1 0\nOR 2 0 0\n")
foreach(backend raw wah ewah roaring concise plwah val sbh bbc)
  run_ok("${BENCH}" "--backend=${backend}" "--dataset=${OUTPUT}/zero/" "--queries=${OUTPUT}/zero/queries.txt"
    "--out=${OUTPUT}/zero/${backend}.csv" --repetitions=1 --warmup=0 --build-repetitions=1 --verify=1)
endforeach()
# Verification must detect an archive from different logical input sets, even
# if its bitmap count and universe size happen to match.
file(MAKE_DIRECTORY "${OUTPUT}/changed")
file(COPY "${DATA}/metadata.txt" DESTINATION "${OUTPUT}/changed")
foreach(id 000 001 002 003 004 005)
  file(COPY "${DATA}/bitmap_${id}.bin" DESTINATION "${OUTPUT}/changed")
endforeach()
configure_file("${DATA}/bitmap_001.bin" "${OUTPUT}/changed/bitmap_000.bin" COPYONLY)
run_bad("${BENCH}" --backend=raw "--dataset=${OUTPUT}/changed" "--queries=${OUTPUT}/queries.txt"
  "--out=${OUTPUT}/mismatch.csv" "--load=${OUTPUT}/raw.bmc" --verify=1)
